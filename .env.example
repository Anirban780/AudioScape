# Google OAuth 2.0 Client ID (Required for Google Identity Services)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend Service Base URLs
VITE_BACKEND_URL=http://localhost:5000
VITE_PROD_BACKEND_URL=https://audio-scape-backend.vercel.app

# Optional Social & Footer URLs (Configurable via Environment Variables)
VITE_GITHUB_URL=https://github.com
VITE_TWITTER_URL=https://twitter.com
VITE_INSTAGRAM_URL=https://instagram.com
VITE_PRIVACY_POLICY_URL=#privacy
VITE_TERMS_OF_SERVICE_URL=#terms
